run="./repl.deploy --standalone ./start.sh"
modules = ["python-3.11"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[nix]
packages = ["glibcLocales", "xcodebuild", "zlib", "mailutils", "imagemagick6"]

[agent]
expertMode = true

[deployment]
deploymentTarget = "autoscale"
run = ["./start.sh"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Bot Server"

[[workflows.workflow]]
name = "Bot Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "MODE=polling ./start.sh"

[workflows.workflow.metadata]
outputType = "console"
